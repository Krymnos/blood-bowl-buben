rules_version = '2';

// Blood Bowl Buben league sync. See docs/LEAGUE-SYNC-FIREBASE.md.
// Members read everything; each coach writes only under coaches/{their uid}.
// Signed-in strangers may only read the participant list and create their own join request. Everyone else gets nothing.
service cloud.firestore {
  match /databases/{database}/documents {

    // The league admin's Firebase Auth uid. Keep in sync with app/src/league.config.ts.
    // Empty = nobody is admin.
    function adminUid() { return '7XTAKf3B7qVjzBVNB3G26KVXv313'; } // ADMIN_UID

    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && adminUid() != '' && request.auth.uid == adminUid(); }
    function isMember() {
      return signedIn() && (isAdmin() || exists(/databases/$(database)/documents/members/$(request.auth.uid)));
    }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function validCoach(name) { return name is string && name.size() > 0 && name.size() <= 40; }
    function localId(id) { return id.matches('^[0-9]{1,15}$'); }

    // Who is in the league. Only the admin adds or removes members.
    match /members/{uid} {
      allow get: if isSelf(uid) || isMember();
      allow list: if isMember();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['coach', 'joinedAt'])
        && validCoach(request.resource.data.coach);
      allow delete: if isAdmin();
    }

    // Join requests: a signed-in user writes (or withdraws) only their own; the admin reviews them.
    match /requests/{uid} {
      allow get: if isSelf(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['coach', 'participant', 'requestedAt'])
        && validCoach(request.resource.data.coach)
        && (!('participant' in request.resource.data) || (request.resource.data.participant is string && request.resource.data.participant.size() <= 40))
        && request.resource.data.requestedAt == request.time;
      allow delete: if isSelf(uid) || isAdmin();
    }

    // The league's participant list: every coach in the league, in the app or not (coach + team name,
    // and the uid once they joined). Signed-in users read it so the join form can offer "who are you?".
    match /participants/{pid} {
      allow read: if signedIn();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['coach', 'team', 'rosterId', 'uid', 'createdAt'])
        && validCoach(request.resource.data.coach)
        && request.resource.data.team is string && request.resource.data.team.size() <= 60
        && (!('rosterId' in request.resource.data) || (request.resource.data.rosterId is string && request.resource.data.rosterId.size() <= 40))
        && (!('uid' in request.resource.data) || (request.resource.data.uid is string && request.resource.data.uid.size() <= 128));
      allow delete: if isAdmin();
    }

    // Results the admin records (from the old league sheet, or games where neither coach uses the app):
    // between two participant-list entries. A coach's own record of the same game replaces it.
    match /results/{rid} {
      allow read: if isMember();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['a', 'b', 'sa', 'sb', 'ca', 'cb', 'date', 'month', 'source', 'createdAt'])
        && request.resource.data.a is string && request.resource.data.a.size() > 0 && request.resource.data.a.size() <= 40
        && request.resource.data.b is string && request.resource.data.b.size() > 0 && request.resource.data.b.size() <= 40
        && request.resource.data.a != request.resource.data.b
        && request.resource.data.sa is int && request.resource.data.sa >= 0 && request.resource.data.sa <= 99
        && request.resource.data.sb is int && request.resource.data.sb >= 0 && request.resource.data.sb <= 99
        && (!('ca' in request.resource.data) || (request.resource.data.ca is int && request.resource.data.ca >= 0 && request.resource.data.ca <= 99))
        && (!('cb' in request.resource.data) || (request.resource.data.cb is int && request.resource.data.cb >= 0 && request.resource.data.cb <= 99))
        && request.resource.data.date is int
        && (!('month' in request.resource.data) || (request.resource.data.month is string && request.resource.data.month.matches('^[0-9]{4}-[0-9]{2}$')))
        && request.resource.data.source in ['sheet', 'admin'];
      allow delete: if isAdmin();
    }

    // Each coach's published data. Owner writes (while a member), members read, admin may clean up.
    match /coaches/{uid} {
      allow read: if isMember();
      allow create, update: if isSelf(uid) && isMember()
        && request.resource.data.keys().hasOnly(['coach', 'device', 'updatedAt'])
        && validCoach(request.resource.data.coach);
      allow delete: if (isSelf(uid) && isMember()) || isAdmin();

      match /{kind}/{docId} {
        allow read: if isMember();
        allow create, update: if isSelf(uid) && isMember()
          && kind in ['teams', 'matches']
          && localId(docId)
          && request.resource.data.keys().hasOnly(['team', 'players', 'match', 'events', 'hash', 'updatedAt']);
        allow delete: if (isSelf(uid) && isMember()) || isAdmin();
      }
    }

    // League view: collection-group queries across all coaches.
    match /{path=**}/teams/{teamId} {
      allow read: if isMember();
    }
    match /{path=**}/matches/{matchId} {
      allow read: if isMember();
    }
  }
}
